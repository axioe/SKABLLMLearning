# 복사해서 .env로 이름을 바꾼 뒤 사용 (로컬 실행용. Streamlit Cloud는 Secrets에 입력)
LLM_BACKEND=auto              # auto(Ollama가 켜져 있으면 Ollama, 아니면 Gemini) / ollama / gemini
OLLAMA_MODEL=gemma4:e2b       # ollama list 에 있는 모델 (gemma2는 메모리 16GB에서 실패)
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
EMBEDDING_BACKEND=auto        # auto(로컬 sentence-transformers → Gemini → BM25만) / huggingface / gemini / none
GRADIO_SHARE=0                # 1이면 Gradio 외부 공유 링크 생성
