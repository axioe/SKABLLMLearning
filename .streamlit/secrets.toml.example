# Streamlit Community Cloud → 앱 Settings → Secrets 에 아래 내용을 붙여 넣는다 (이 파일 자체는 올리지 않아도 됨)
# 로컬에서 테스트할 때는 이 파일을 .streamlit/secrets.toml 로 복사 (.gitignore에 포함되어 저장소에 올라가지 않음)
GEMINI_API_KEY = "여기에_Google_AI_Studio_API_키"
GEMINI_MODEL = "gemini-2.5-flash"
LLM_BACKEND = "auto"          # 서버에는 Ollama가 없으므로 auto → gemini
EMBEDDING_BACKEND = "auto"    # 서버에는 sentence-transformers가 없으므로 auto → gemini
